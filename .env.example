# Folder that holds data/ and scripts/. Defaults to this checkout.
BUSINESS_OPS_ROOT=
# Shared key required by the Next.js API route (cookie business_ops_key or header x-business-ops-key).
BUSINESS_OPS_KEY=
# Parent folder where adapter projects are checked out (defaults to the parent of BUSINESS_OPS_ROOT).
BUSINESS_OPS_ADAPTERS_ROOT=
# Optional per-adapter overrides.
BUSINESS_OPS_AGENTPROOF_DIR=
BUSINESS_OPS_BAYLIFT_DIR=
BUSINESS_OPS_NATIVE_SUPPLY_DIR=
BUSINESS_OPS_ARSENAL_DIR=
# Folder with leads.json, pipeline.json, followups.json, outreach.json, suppression.json, send-ledger.jsonl (default <root>/data).
BUSINESS_OPS_PIPELINE_DIR=
# Optional script that prints {"allowed_now":N,"blockers":[]}; without it, send eligibility is reported as unknown.
BUSINESS_OPS_SEND_GUARD=
# Optional https origin you own; the worker keeps a weekly site-audit monitor on it.
BUSINESS_OPS_CANARY_URL=
# Python used for the lease helper and the snapshot adapter (default python3).
BUSINESS_OPS_PYTHON=
